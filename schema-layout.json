{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Melocet/glow-themes/schema-layout.json",
  "title": "Glow community layout",
  "description": "A shareable Glow profile layout: which base layout, and how the sections are arranged. Declarative data only, no code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "layout"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 3, "maxLength": 40 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 },
    "description": { "type": "string", "maxLength": 200 },
    "tags": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 20 } },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {
          "type": "string",
          "enum": ["SIMPLE", "ADVANCED", "SHOWCASE", "LINKS", "GRID"],
          "description": "The built-in layout this builds on. Use GRID for a free-form 12-column layout (see the grid property)."
        },
        "sections": {
          "type": "array",
          "description": "For non-GRID bases: section order, visibility and detail. Unknown keys are ignored.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": {
                "type": "string",
                "enum": ["stats", "games", "steam", "psn", "retro", "anime", "music", "lol", "valorant", "minecraft", "genres", "discord"]
              },
              "visible": { "type": "boolean" },
              "detailLevel": { "type": "string", "enum": ["compact", "detailed"] },
              "order": { "type": "number" }
            }
          }
        },
        "grid": {
          "type": "object",
          "description": "Free-form 12-column grid. Used when base is GRID. Place widgets anywhere; positions are clamped into the grid on import.",
          "additionalProperties": false,
          "required": ["widgets"],
          "properties": {
            "gap": { "type": "number", "minimum": 0, "maximum": 8, "description": "Gap between cells (Tailwind spacing units, default 4)." },
            "widgets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["widget", "x", "y", "w"],
                "properties": {
                  "id": { "type": "string", "description": "Optional stable id (defaults to the widget key)." },
                  "widget": {
                    "type": "string",
                    "enum": ["header", "identity", "links", "badges", "stats", "games", "steam", "psn", "retro", "anime", "genres", "discord"],
                    "description": "Which widget to place."
                  },
                  "x": { "type": "number", "minimum": 0, "maximum": 11, "description": "Column start, 0 to 11." },
                  "y": { "type": "number", "minimum": 0, "description": "Row hint, controls order and mobile stacking." },
                  "w": { "type": "number", "minimum": 1, "maximum": 12, "description": "Column span, 1 to 12 (clamped so x + w stays within 12)." },
                  "h": { "type": "number", "minimum": 1, "description": "Optional row span." },
                  "detail": { "type": "string", "enum": ["compact", "detailed"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
